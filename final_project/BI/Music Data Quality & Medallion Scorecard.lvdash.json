{
  "datasets": [
    {
      "name": "quality_summary",
      "displayName": "Quality Summary",
      "queryLines": [
        "WITH clean AS (\n",
        "  SELECT\n",
        "    COUNT(*) AS clean_count\n",
        "  FROM\n",
        "    silver_music_metadata\n",
        "),\n",
        "quarantine AS (\n",
        "  SELECT\n",
        "    COUNT(*) AS quarantine_count\n",
        "  FROM\n",
        "    silver_music_quarantine\n",
        ")\n",
        "SELECT\n",
        "  ROUND(\n",
        "    CASE\n",
        "      WHEN clean.clean_count + quarantine.quarantine_count = 0 THEN 0.0\n",
        "      ELSE 100.0 * clean.clean_count / (clean.clean_count + quarantine.quarantine_count)\n",
        "    END,\n",
        "    2\n",
        "  ) AS pass_rate_pct,\n",
        "  clean.clean_count + quarantine.quarantine_count AS total_ingested,\n",
        "  quarantine.quarantine_count AS quarantine_count,\n",
        "  CASE\n",
        "    WHEN quarantine.quarantine_count = 0 THEN 'HEALTHY'\n",
        "    WHEN\n",
        "      ROUND(\n",
        "        CASE\n",
        "          WHEN clean.clean_count + quarantine.quarantine_count = 0 THEN 0.0\n",
        "          ELSE 100.0 * clean.clean_count / (clean.clean_count + quarantine.quarantine_count)\n",
        "        END,\n",
        "        2\n",
        "      ) >= 95\n",
        "    THEN\n",
        "      'WARNING'\n",
        "    ELSE 'CRITICAL'\n",
        "  END AS pipeline_status\n",
        "FROM\n",
        "  clean CROSS JOIN quarantine"
      ],
      "catalog": "dbr_dev",
      "schema": "music_analytics"
    },
    {
      "name": "medallion_flow",
      "displayName": "Medallion Reconciliation Flow",
      "queryLines": [
        "SELECT\n",
        "  '1. Bronze Raw Keys' AS layer_name,\n",
        "  COUNT(DISTINCT COALESCE(url, 'missing_url')) AS record_count -- We want to include missing values in the count\n",
        "FROM\n",
        "  bronze_music_metadata\n",
        "UNION ALL\n",
        "SELECT\n",
        "  '2. Silver Clean' AS layer_name,\n",
        "  COUNT(*) AS record_count\n",
        "FROM\n",
        "  silver_music_metadata\n",
        "UNION ALL\n",
        "SELECT\n",
        "  '2. Silver Quarantine' AS layer_name,\n",
        "  COUNT(*) AS record_count\n",
        "FROM\n",
        "  silver_music_quarantine\n",
        "UNION ALL\n",
        "SELECT\n",
        "  '3. Gold Dimension' AS layer_name,\n",
        "  COUNT(*) AS record_count\n",
        "FROM\n",
        "  dim_music_metadata"
      ],
      "catalog": "dbr_dev",
      "schema": "music_analytics"
    },
    {
      "name": "quarantine_inspection",
      "displayName": "Quarantine Inspection",
      "queryLines": [
        "SELECT\n",
        "  url,\n",
        "  author,\n",
        "  album,\n",
        "  title,\n",
        "  _ingested_at,\n",
        "  `_quarantine_reason` AS invalid_reason\n",
        "FROM\n",
        "  silver_music_quarantine\n",
        "ORDER BY\n",
        "  _ingested_at DESC"
      ],
      "catalog": "dbr_dev",
      "schema": "music_analytics"
    }
  ],
