{
  "datasets": [
    {
      "name": "music_artist_explorer",
      "displayName": "Music Artist Explorer",
      "queryLines": [
        "WITH metadata AS (\n",
        "  SELECT DISTINCT\n",
        "    video_id,\n",
        "    COALESCE(author, 'Unknown Artist') AS author,\n",
        "    COALESCE(album, 'Unknown Album') AS album,\n",
        "    COALESCE(title, 'Unknown Track') AS title,\n",
        "    album_release_date\n",
        "  FROM\n",
        "    IDENTIFIER(concat(:catalog_name, '.', :schema_name, '.dim_music_metadata'))\n",
        "),\n",
        "facts AS (\n",
        "  SELECT\n",
        "    video_id,\n",
        "    ingested_at_minutes,\n",
        "    total_views,\n",
        "    total_likes,\n",
        "    total_comments\n",
        "  FROM\n",
        "    IDENTIFIER(concat(:catalog_name, '.', :schema_name, '.fact_music_stats'))\n",
        ")\n",
        "SELECT\n",
        "  m.author,\n",
        "  m.album,\n",
        "  m.title,\n",
        "  m.album_release_date,\n",
        "  f.video_id,\n",
        "  f.ingested_at_minutes,\n",
        "  f.total_views,\n",
        "  f.total_likes,\n",
        "  f.total_comments\n",
        "FROM\n",
        "  facts f\n",
        "    INNER JOIN metadata m\n",
        "      ON f.video_id = m.video_id\n",
        "WHERE\n",
        "  m.author IS NOT NULL\n",
        "  AND m.album IS NOT NULL"
      ],
      "parameters": [
        {
          "displayName": "Catalog",
          "keyword": "catalog_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "dbr_dev"
                }
              ]
            }
          }
        },
        {
          "displayName": "Schema",
          "keyword": "schema_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "music_analytics"
                }
              ]
            }
          }
        }
      ]
    }
  ],
